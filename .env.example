# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Admin credentials for the CMS.
# Prefer ADMIN_PASSWORD_SHA256 in production. If both are set, the hash takes priority.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_SHA256=""
ADMIN_REPORT_EMAIL="admin@example.com"

# APP_URL: The canonical public URL for production.
# Used for canonical tags, Open Graph URLs, sitemap URLs, and redirecting old hosts.
# Example production value:
APP_URL="https://amantubillahi.com"
